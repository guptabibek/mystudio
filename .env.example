# ===========================================
# Photo Studio Booking Platform - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# ===========================================

# ===========================================
# DATABASE
# ===========================================
# PostgreSQL connection string (production)
DATABASE_URL="postgresql://user:password@localhost:5432/photostudio?schema=public"

# ===========================================
# APPLICATION
# ===========================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="PhotoStudio"
NODE_ENV="development"

# ===========================================
# AUTHENTICATION
# ===========================================
# Generate a secure secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# JWT Settings
JWT_SECRET="your-jwt-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"

# ===========================================
# STRIPE PAYMENT GATEWAY
# ===========================================
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"

# ===========================================
# ESEWA PAYMENT GATEWAY (Nepal)
# ===========================================
ESEWA_MERCHANT_ID="EPAYTEST"
ESEWA_SECRET_KEY="8gBm/:&EnhH.1/q"
ESEWA_FORM_URL="https://rc-epay.esewa.com.np/api/epay/main/v2/form"
ESEWA_API_URL="https://rc-epay.esewa.com.np/api/epay/main/v2/form" # Backward compatibility
ESEWA_STATUS_CHECK_URL="https://rc.esewa.com.np/api/epay/transaction/status/"
ESEWA_CALLBACK_BASE_URL="http://localhost:3000"
ESEWA_SUCCESS_URL="http://localhost:3000/api/payments/esewa/success"
ESEWA_FAILURE_URL="http://localhost:3000/api/payments/esewa/failure"
ESEWA_STATUS_TIMEOUT_MS="12000"
ESEWA_STATUS_RETRIES="1"

# Production eSewa URLs:
# ESEWA_FORM_URL="https://epay.esewa.com.np/api/epay/main/v2/form"
# ESEWA_STATUS_CHECK_URL="https://esewa.com.np/api/epay/transaction/status/"

# ===========================================
# AWS S3 / CLOUDFLARE R2 STORAGE
# ===========================================
# For AWS S3
AWS_ACCESS_KEY_ID="your_aws_access_key"
AWS_SECRET_ACCESS_KEY="your_aws_secret_key"
AWS_REGION="us-east-1"
S3_BUCKET_NAME="photostudio-uploads"

# For Cloudflare R2 (S3-compatible)
# R2_ACCOUNT_ID="your_account_id"
# R2_ACCESS_KEY_ID="your_r2_access_key"
# R2_SECRET_ACCESS_KEY="your_r2_secret_key"
# R2_BUCKET_NAME="photostudio-uploads"
# R2_PUBLIC_URL="https://your-bucket.your-domain.com"

# ===========================================
# EMAIL SERVICE (SendGrid / Resend)
# ===========================================
# SendGrid
SENDGRID_API_KEY="SG.your_sendgrid_api_key"
SENDGRID_FROM_EMAIL="noreply@yourdomain.com"
SENDGRID_FROM_NAME="PhotoStudio"

# Resend (alternative)
# RESEND_API_KEY="re_your_resend_api_key"
# RESEND_FROM_EMAIL="noreply@yourdomain.com"

# ===========================================
# REDIS (Rate Limiting & Caching)
# ===========================================
REDIS_URL="redis://localhost:6379"
# For Redis with authentication:
# REDIS_URL="redis://username:password@localhost:6379"

# ===========================================
# FILE UPLOAD SETTINGS
# ===========================================
MAX_FILE_SIZE="52428800" # 50MB in bytes
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/webp,image/heic"
MAX_PHOTOS_PER_COLLECTION="100"

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_MAX_REQUESTS="100"
RATE_LIMIT_WINDOW_MS="60000" # 1 minute

# ===========================================
# SECURITY
# ===========================================
# CORS allowed origins (comma-separated)
CORS_ORIGINS="http://localhost:3000,https://yourdomain.com"

# Password hashing
BCRYPT_SALT_ROUNDS="12"

# ===========================================
# OPTIONAL: OAUTH PROVIDERS
# ===========================================
# Google OAuth
# GOOGLE_CLIENT_ID="your_google_client_id"
# GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Facebook OAuth
# FACEBOOK_CLIENT_ID="your_facebook_client_id"
# FACEBOOK_CLIENT_SECRET="your_facebook_client_secret"

# ===========================================
# OPTIONAL: MONITORING & LOGGING
# ===========================================
# Sentry Error Tracking
# NEXT_PUBLIC_SENTRY_DSN="https://your_sentry_dsn"
# SENTRY_AUTH_TOKEN="your_sentry_auth_token"

# Log level: debug, info, warn, error
LOG_LEVEL="info"

# ===========================================
# OPTIONAL: ANALYTICS
# ===========================================
# Google Analytics
# NEXT_PUBLIC_GA_TRACKING_ID="UA-XXXXXXXXX-X"

# ===========================================
# DEVELOPMENT ONLY
# ===========================================
# Skip email sending in development
SKIP_EMAIL_SENDING="true"

# Seed admin credentials
SEED_ADMIN_EMAIL="admin@photostudio.com"
SEED_ADMIN_PASSWORD="admin123"
